flowchart TD
    %% Styling Classes
    classDef inputStyle fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#0d47a1;
    classDef processStyle fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1b5e20;
    classDef modelStyle fill:#ede7f6,stroke:#512da8,stroke-width:2px,color:#311b92;
    classDef decisionStyle fill:#fffde7,stroke:#fbc02d,stroke-width:2px,color:#f57f17;
    classDef outputStyle fill:#e0f2f1,stroke:#00695c,stroke-width:2px,color:#004d40;
    classDef dbStyle fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#bf360c;

    A["Input Video"]:::inputStyle --> B["Extract Audio<br/>16 kHz Mono"]:::processStyle
    
    B --> C["Segment Audio<br/>3s Window + 1s Overlap"]:::processStyle
    
    C --> D{"Non-Silent Segment?"}:::decisionStyle
    D -- No --> Z["Skip"]:::processStyle
    D -- Yes --> E["Faster-Whisper<br/>Speech Detection + Timestamps"]:::modelStyle
    
    E --> F["Speech Facts<br/>Text + Start/End Time"]:::outputStyle
    
    E --> G["Remove Speech Intervals"]:::processStyle
    
    G --> H["LAION-CLAP<br/>Background Sound Detection"]:::modelStyle
    
    H --> I{"Sound Confidence<br/>+ Minimum Duration?"}:::decisionStyle
    I -- No --> Z
    I -- Yes --> J["Sound Facts<br/>Label + Start/End Time"]:::outputStyle
    
    F --> K["Merge + Sort<br/>All Audio Facts"]:::processStyle
    J --> K
    
    K --> L["Final Audio Timeline"]:::outputStyle
    L --> M[("ChromaDB")]:::dbStyle
